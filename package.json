{
  "name": "bb-plugin-secure-bb",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.149"
  },
  "bb": {
    "name": "Secure BB",
    "description": "Gate for plugin code: decides whether other plugins may load, with one-time registration, TOTP approvals and trust windows. Guides you through the protection levels of your bb.",
    "branding": {
      "icon": "Shield"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs --output-type err . && depcruise --config .dependency-cruiser.browser.cjs --output-type err app.tsx"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.149",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dependency-cruiser": "18.8.0",
    "jsdom": "^26.0.0",
    "tailwind-merge": "3.7.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
